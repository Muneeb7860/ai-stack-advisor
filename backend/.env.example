# Copy to .env and fill in for local dev. Never commit the real .env.

# Postgres (matches docker-compose.yml service "db")
DATABASE_URL=postgresql+psycopg2://advisor:advisor@localhost:5432/advisor

# CORS: comma-separated origins allowed to call this API from a browser.
# The v1 frontend (index.html) is a static file opened directly / hosted separately —
# add its real origin here once it has one.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# NOTE on Anthropic API keys (locked decision — see docs/design-doc-v2.md Section 7):
# This backend does NOT read an ANTHROPIC_API_KEY from its own environment for the
# /api/refine or /api/ask endpoints. Each request carries the user's own key in the
# request body as `anthropic_api_key` (settled convention — both endpoints implement it
# identically, see schemas.RefineRequest / schemas.AskRequest), the backend passes it
# straight through to the Anthropic SDK for that one request, and never persists or logs
# it. This preserves the "bring your own key, we store nothing" privacy posture from the
# BRD/PRD. Do not add a shared server-side key here.

# --- Retrieval embeddings (app/retrieval.py) ---
# Local Ollama daemon used to embed the knowledge-base corpus for RAG grounding — see
# retrieval.py's module docstring for why a local model (not a cloud embeddings API).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Local-model fallback for /api/refine and /api/ask (app/llm_providers.py) ---
# Claude (Anthropic) stays the PRIMARY provider always. LLM_PROVIDER=ollama only *enables* an
# additional, opt-in, clearly-labeled-as-degraded local path — callers must also explicitly
# pass provider="ollama" on the request to use it; setting this alone does not reroute
# existing Claude-backed traffic. Leave unset ("anthropic") unless you specifically want to
# offer an offline/no-API-key fallback. See app/llm_providers.py's docstring for real measured
# structured-output reliability numbers behind this choice.
LLM_PROVIDER=anthropic
OLLAMA_MODEL=qwen2.5:7b
